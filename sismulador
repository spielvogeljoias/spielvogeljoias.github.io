<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Spielvogel Joias — Simulador de conversa</title>
<link rel="stylesheet" href="tema.css">
<script src="tema.js"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">
<style>
/* Conceito: bancada de ensaio. Um telefone com a conversa no centro, o percurso e os dados do cliente ao lado, e uma segunda vista que abre todos os perfis em colunas. */
:root {
  --page: #f1f0ed;
  --surface: #fbfaf8;
  --ink: #1e2321;
  --ink-2: #59605c;
  --line: #d9d7d1;
  --accent: #7d5a2c;
  --accent-ink: #ffffff;
  --focus: #7d5a2c;
  --chat-head: #f0f2f5;
  --chat-bg: #efeae2;
  --out: #d9fdd3;
  --out-ink: #111b21;
  --in: #ffffff;
  --in-ink: #111b21;
  --sim-line: #8a918c;
  --sys-bg: #fff4c2;
  --sys-ink: #54480a;
  --cp: #2f6a56;
  --media: #bfe5b8;
  --media-ink: #1f4d3a;
  --f-ui: "Hanken Grotesk", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --f-display: "Cormorant Garamond", Georgia, "Times New Roman", serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --page: #131615;
    --surface: #1b1f1d;
    --ink: #e8ebe8;
    --ink-2: #a2a9a5;
    --line: #2c322f;
    --accent: #d8a76a;
    --accent-ink: #1a1209;
    --focus: #d8a76a;
    --chat-head: #202c33;
    --chat-bg: #0b141a;
    --out: #005c4b;
    --out-ink: #e9edef;
    --in: #202c33;
    --in-ink: #e9edef;
    --sim-line: #6f7b81;
    --sys-bg: #182229;
    --sys-ink: #e0c97a;
    --cp: #8fd8c1;
    --media: #0a3f34;
    --media-ink: #d3f2e8;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --page: #131615;
  --surface: #1b1f1d;
  --ink: #e8ebe8;
  --ink-2: #a2a9a5;
  --line: #2c322f;
  --accent: #d8a76a;
  --accent-ink: #1a1209;
  --focus: #d8a76a;
  --chat-head: #202c33;
  --chat-bg: #0b141a;
  --out: #005c4b;
  --out-ink: #e9edef;
  --in: #202c33;
  --in-ink: #e9edef;
  --sim-line: #6f7b81;
  --sys-bg: #182229;
  --sys-ink: #e0c97a;
  --cp: #8fd8c1;
  --media: #0a3f34;
  --media-ink: #d3f2e8;
  color-scheme: dark;
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }
body {
  background: var(--page);
  color: var(--ink);
  font: 400 15px/1.5 var(--f-ui);
}
button, input { font: inherit; color: inherit; }
button { cursor: pointer; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

.shell {
  max-width: 1120px;
  margin: 0 auto;
  padding-block: 28px 56px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}

/* Cabeçalho */
.top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 24px; }
.eyebrow { margin: 0 0 4px; font-size: 12.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
h1 { margin: 0; font: 700 38px/1.05 var(--f-display); letter-spacing: 0.005em; text-wrap: balance; }
.intro { margin: 14px 0 26px; max-width: 62ch; color: var(--ink-2); }

.tabs { display: inline-flex; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
.tab { border: 0; background: transparent; padding: 8px 18px; border-radius: 999px; font-weight: 600; font-size: 14px; color: var(--ink-2); }
.tab[aria-selected="true"] { background: var(--ink); color: var(--page); }

/* Vista passo a passo */
.sim { display: grid; grid-template-columns: minmax(260px, 340px) minmax(0, 560px); gap: 28px; align-items: start; }
.side { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 18px; }
.panel h2 { margin: 0; font: 700 21px/1.2 var(--f-display); }
.panel-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
.hint { margin: 6px 0 16px; font-size: 13px; color: var(--ink-2); }
.field { margin-bottom: 14px; }
.field:last-child { margin-bottom: 0; }
.lbl { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: var(--ink-2); }
.field input[type="text"], .field select { width: 100%; padding: 9px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--page); color: var(--ink); }
.seg { display: inline-flex; }
.seg label { position: relative; display: block; }
.seg input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
.seg span { display: block; padding: 7px 20px; border: 1px solid var(--line); background: var(--page); font-size: 14px; font-weight: 500; }
.seg label:first-child span { border-radius: 10px 0 0 10px; }
.seg label:last-child span { border-radius: 0 10px 10px 0; border-left-width: 0; }
.seg input:checked + span { background: var(--ink); color: var(--page); border-color: var(--ink); }
.seg input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 2px; }

.btns { display: flex; gap: 8px; }
.mini { border: 1px solid var(--line); background: var(--page); border-radius: 8px; padding: 5px 12px; font-size: 13px; font-weight: 600; }
.mini:hover:not(:disabled) { border-color: var(--accent); }
.mini:disabled, .opt:disabled { opacity: 0.45; cursor: default; }
#trail { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
#trail .empty { font-size: 13.5px; color: var(--ink-2); }
.trail-item { width: 100%; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; text-align: left; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--page); font-size: 14px; }
.trail-item:hover { border-color: var(--accent); }
.trail-item .redo { flex: none; font-size: 12px; color: var(--ink-2); }

/* Telefone */
.phone { width: 100%; max-width: 560px; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; background: var(--chat-bg); }
.chat-head { display: flex; align-items: center; gap: 12px; padding: 10px 16px; background: var(--chat-head); border-bottom: 1px solid var(--line); }
.avatar { flex: none; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--accent-ink); font-weight: 700; }
.chat-head strong { display: block; line-height: 1.2; }
.chat-head small { color: var(--ink-2); font-size: 12.5px; }
.chat-body { height: 520px; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 6px; }
.legend { margin: 10px 0 0; font-size: 13px; color: var(--ink-2); display: flex; align-items: center; gap: 8px; }
.swatch { flex: none; width: 26px; height: 14px; border: 1.5px dashed var(--sim-line); border-radius: 5px; }

.b { max-width: 86%; padding: 8px 12px 6px; border-radius: 10px; font-size: 14.5px; line-height: 1.42; overflow-wrap: anywhere; }
.b p { margin: 0; white-space: pre-line; }
.b p + p { margin-top: 8px; }
.b .tag { display: block; margin-bottom: 4px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--cp); }
.b.l { align-self: flex-end; background: var(--out); color: var(--out-ink); border-top-right-radius: 2px; }
.b.c { align-self: flex-start; background: var(--in); color: var(--in-ink); border-top-left-radius: 2px; }
.b.c.sim { background: transparent; color: var(--ink); border: 1.5px dashed var(--sim-line); }
.cp { display: block; margin: 4px 0 0 auto; padding: 2px 0; border: 0; background: none; font-size: 12px; font-weight: 700; color: var(--cp); }
.cp:hover { text-decoration: underline; }
.sys { align-self: center; max-width: 90%; padding: 4px 12px; border-radius: 8px; background: var(--sys-bg); color: var(--sys-ink); font-size: 12.5px; text-align: center; margin-block: 4px; }
.todo { align-self: stretch; margin-block: 6px; padding: 10px 12px; border: 1.5px dashed var(--sim-line); border-radius: 10px; color: var(--ink-2); font-size: 13.5px; }
.media { align-self: flex-end; width: min(86%, 270px); padding: 6px; border-radius: 10px; border-top-right-radius: 2px; background: var(--out); color: var(--out-ink); }
.media .shot { aspect-ratio: 16 / 10; border-radius: 6px; background: var(--media); color: var(--media-ink); display: grid; place-items: center; }
.media .play { width: 44px; height: 44px; border-radius: 50%; border: 2px solid currentColor; display: grid; place-items: center; }
.media p { margin: 6px 4px 2px; font-size: 13px; }
.in-anim { animation: rise 0.22s ease-out both; }
@keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

.tray { padding: 12px 14px 14px; background: var(--chat-head); border-top: 1px solid var(--line); }
.prompt { margin: 0 0 8px; font-size: 13px; font-weight: 600; color: var(--ink-2); }
.opts { display: flex; flex-wrap: wrap; gap: 8px; }
.opt { padding: 9px 14px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); color: var(--ink); font-size: 14px; font-weight: 500; text-align: left; }
.opt:hover:not(:disabled) { border-color: var(--accent); }
.opt.ghost { background: transparent; border-style: dashed; color: var(--ink-2); }
.tray .sep { margin: 12px 0 8px; border: 0; border-top: 1px solid var(--line); }
.topics { margin-top: 8px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
.topics summary { padding: 9px 14px; font-size: 13.5px; font-weight: 600; cursor: pointer; border-radius: 12px; }
.topics[open] summary { border-bottom: 1px solid var(--line); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.topics .opts { padding: 10px 12px 12px; max-height: 190px; overflow-y: auto; }
.topics .opt { padding: 7px 12px; font-size: 13.5px; }

/* Conversas em paralelo */
.convs { display: flex; gap: 8px; align-items: stretch; margin: 0 0 20px; overflow-x: auto; padding-bottom: 6px; }
.conv { flex: none; display: flex; align-items: center; gap: 4px; padding: 5px 6px 5px 5px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); max-width: 250px; }
.conv[aria-current="true"] { border-color: var(--accent); background: var(--page); box-shadow: 0 0 0 1px var(--accent) inset; }
.conv-main { display: flex; align-items: center; gap: 9px; border: 0; background: none; text-align: left; min-width: 0; padding: 2px 6px 2px 2px; }
.conv .avatar { width: 32px; height: 32px; font-size: 14px; }
.conv-txt { min-width: 0; }
.conv-txt strong { display: block; font-size: 13.5px; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px; }
.conv-txt small { display: block; font-size: 11.5px; line-height: 1.3; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px; }
.conv-x { border: 0; background: none; color: var(--ink-2); font-size: 16px; line-height: 1; padding: 6px 7px; border-radius: 8px; }
.conv-x:hover { color: var(--ink); background: var(--line); }
.conv-x.sure { color: #e0786b; font-weight: 700; font-size: 12px; }
.conv-new { flex: none; border: 1px dashed var(--sim-line); background: transparent; border-radius: 14px; padding: 0 16px; font-weight: 600; font-size: 13.5px; color: var(--ink-2); }
.conv-new:hover { border-color: var(--accent); color: var(--ink); }

/* Vista lado a lado */
.sec { margin-bottom: 40px; }
.sec h2 { margin: 0 0 4px; font: 700 26px/1.15 var(--f-display); }
.sec .lead { margin: 0 0 16px; color: var(--ink-2); font-size: 14px; }
.cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 16px; align-items: start; }
.col { min-width: 0; background: var(--chat-bg); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
.col-head { padding: 10px 14px; background: var(--chat-head); border-bottom: 1px solid var(--line); font-weight: 600; font-size: 14px; }
.col-body { padding: 14px; display: flex; flex-direction: column; gap: 8px; }
.col .b, .col .media { align-self: stretch; max-width: 100%; width: auto; }
.cols.five { grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); }
.common { max-width: 560px; margin-bottom: 16px; }
.common .b, .common .media { align-self: flex-end; max-width: 86%; }
.common .media { width: min(86%, 270px); }

@media (max-width: 880px) {
  .sim { grid-template-columns: minmax(0, 1fr); }
  .stage { order: -1; }
  .phone { max-width: none; }
  h1 { font-size: 32px; }
}
@media (prefers-reduced-motion: reduce) {
  .in-anim { animation: none; }
}
</style>

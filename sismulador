        <div class="field">
          <span class="lbl" id="l-cliente">O cliente é</span>
          <div class="seg" role="radiogroup" aria-labelledby="l-cliente">
            <label><input type="radio" name="cliente" value="ela" checked><span>Ela</span></label>
            <label><input type="radio" name="cliente" value="ele"><span>Ele</span></label>
          </div>
        </div>
        <div class="field">
          <span class="lbl" id="l-presenteado">Quem vai receber a joia</span>
          <div class="seg" role="radiogroup" aria-labelledby="l-presenteado">
            <label><input type="radio" name="presenteado" value="ela" checked><span>Ela</span></label>
            <label><input type="radio" name="presenteado" value="ele"><span>Ele</span></label>
          </div>
        </div>
        <div class="field">
          <label class="lbl" for="f-modelo">Modelo do anúncio</label>
          <select id="f-modelo">
            <option value="marquise">Anel Marquise</option>
            <option value="sechs" selected>Anel Sechs</option>
            <option value="laub">Anel Laub</option>
            <option value="oval">Anel Oval</option>
            <option value="ziel">Anel Ziel</option>
          </select>
        </div>
      </section>

      <section class="panel" aria-labelledby="h-percurso">
        <div class="panel-head">
          <h2 id="h-percurso">Percurso</h2>
          <div class="btns">
            <button class="mini" id="b-back" type="button">Voltar</button>
            <button class="mini" id="b-reset" type="button">Reiniciar</button>
          </div>
        </div>
        <ol id="trail"></ol>
      </section>
    </aside>

    <div class="stage">
      <div class="phone" aria-label="Conversa simulada">
        <div class="chat-head">
          <span class="avatar" id="avatar" aria-hidden="true">I</span>
          <div><strong id="chat-name">Ingrid</strong><small>online</small></div>
        </div>
        <div class="chat-body" id="chat" role="log" aria-live="polite"></div>
        <div class="tray" id="tray"></div>
      </div>
      <p class="legend"><span class="swatch" aria-hidden="true"></span>Balões tracejados são respostas simuladas do cliente.</p>
    </div>
  </section>

  <section id="view-lado" role="tabpanel" aria-labelledby="tab-lado" hidden>
    <div id="sbs"></div>
  </section>
</div>


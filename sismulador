  var convs = [], cur = 0, armed = -1, armTimer = null;
  var STORE = 'sv-simulador-conversas-v1';
  function novoS() { return { nome: '', cliente: 'ela', presenteado: 'ela', modelo: 'Anel Sechs', modeloId: 'sechs' }; }
  function saveStore() {
    try {
      localStorage.setItem(STORE, JSON.stringify({ cur: cur, convs: convs.map(function (c) { return { S: c.S, history: c.history }; }) }));
    } catch (e) { /* sem armazenamento disponível: as conversas só duram até fechar a página */ }
  }
  function loadStore() {
    try {
      var d = JSON.parse(localStorage.getItem(STORE) || 'null');
      if (!d || !Array.isArray(d.convs) || !d.convs.length) return false;
      convs = d.convs.map(function (c) {
        return { S: Object.assign(novoS(), c.S || {}), history: Array.isArray(c.history) ? c.history : [] };
      });
      cur = Math.min(Math.max(d.cur || 0, 0), convs.length - 1);
      return true;
    } catch (e) { return false; }
  }

  function fill(t) {
    return t.replace(/\{(\w+)\}/g, function (m, k) {
      if (!(k in S)) return m;

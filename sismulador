      var g = el('div', { class: 'opts' });
      r.ask.opts.forEach(function (o) {
        g.appendChild(el('button', { class: 'opt', type: 'button', onclick: function () { choose(r.ask.key, o.id, r.ask.node); } }, fill(o.label)));
      });
      tray.appendChild(g);
    } else {
      tray.appendChild(el('p', { class: 'prompt' }, 'Fim do percurso. Use o percurso ao lado para refazer uma escolha.'));
    }
    if (r.hasOrigin) {
      tray.appendChild(el('hr', { class: 'sep' }));
      tray.appendChild(topicsBox('Perguntas e objeções, a qualquer momento', TOPICS, r.used));
      if (r.sale) tray.appendChild(topicsBox('Pós-venda, a qualquer momento', TOPICS2, r.used));
    }
  }

  function renderTrail(r) {
    trailEl.textContent = '';
    if (!r.trail.length) {
      trailEl.appendChild(el('li', { class: 'empty' }, 'Nenhuma escolha ainda. Comece pela origem do contato.'));
    }
    r.trail.forEach(function (t, i) {
      trailEl.appendChild(el('li', null, el('button', {
        class: 'trail-item', type: 'button', title: 'Refazer a partir daqui', 'aria-label': 'Refazer a partir de: ' + t,
        onclick: function () { history = history.slice(0, i); render(true); }
      }, el('span', null, t), el('span', { class: 'redo' }, 'Refazer'))));
    });
    document.getElementById('b-back').disabled = history.length === 0;
  }

  function render(toBottom) {
    if (convs[cur]) { convs[cur].S = S; convs[cur].history = history; }
    var r = build();
    var keep = chat.scrollTop;
    var from = toBottom ? Math.min(shown, r.out.length) : r.out.length;
    chat.textContent = '';
    r.out.forEach(function (b, i) {
      var n = bubble(b);
      if (i >= from) n.classList.add('in-anim');
      chat.appendChild(n);
    });
    shown = r.out.length;
    renderTray(r);
    renderTrail(r);
    if (toBottom) {
      requestAnimationFrame(function () {
        chat.scrollTo({ top: chat.scrollHeight, behavior: reduce ? 'auto' : 'smooth' });
      });
    } else {
      chat.scrollTop = keep;
    }
    renderSbs();
    saveStore();
    renderConvs();
  }

  /* ---------- Barra de conversas ---------- */
  function summary(c) {
    var s0 = S, h0 = history, txt = 'Escolher a origem';
    S = c.S; history = c.history;
    try {
      var r = build();
      if (r.trail.length) txt = r.trail[r.trail.length - 1];
    } catch (e) { /* conversa com passo inválido */ }
    S = s0; history = h0;
    return txt;
  }
  function syncForm() {
    document.getElementById('f-nome').value = S.nome;
    document.getElementById('f-modelo').value = S.modeloId;
    Array.prototype.forEach.call(document.querySelectorAll('input[name="cliente"], input[name="presenteado"]'), function (inp) {
      inp.checked = S[inp.name] === inp.value;
    });
    syncHead();
  }
  function activate(i) {
    cur = i; armed = -1;
    S = convs[i].S; history = convs[i].history;
    shown = 1e6;
    syncForm();
    render(false);
    chat.scrollTop = chat.scrollHeight;
  }
  function newConv() {
    convs.push({ S: novoS(), history: [] });
    activate(convs.length - 1);
    if (window.innerWidth > 760) document.getElementById('f-nome').focus({ preventScroll: true });
  }
  function removeConv(i) {
    convs.splice(i, 1);
    armed = -1;
    if (i < cur) cur--;
    if (i === cur || cur >= convs.length) { cur = Math.min(cur, convs.length - 1); activate(cur); }
    else { render(false); }
  }
  function renderConvs() {
    var box = document.getElementById('convs');
    if (!box) return;
    box.textContent = '';
    convs.forEach(function (c, i) {
      var nome = (c.S.nome || '').trim();
      var chip = el('div', { class: 'conv', 'aria-current': i === cur ? 'true' : 'false' },
        el('button', { class: 'conv-main', type: 'button', onclick: function () { if (i !== cur) activate(i); } },
          el('span', { class: 'avatar', 'aria-hidden': 'true' }, (nome ? nome.charAt(0) : '?').toUpperCase()),
          el('span', { class: 'conv-txt' }, el('strong', null, nome || 'Nova conversa'), el('small', null, summary(c)))
        ),
        convs.length > 1 ? el('button', {
          class: 'conv-x' + (armed === i ? ' sure' : ''), type: 'button',
          'aria-label': 'Apagar a conversa de ' + (nome || 'cliente sem nome'),
          onclick: function () {
            if (armed === i) { clearTimeout(armTimer); removeConv(i); return; }
            armed = i; renderConvs();
            clearTimeout(armTimer);
            armTimer = setTimeout(function () { armed = -1; renderConvs(); }, 3000);
          }
        }, armed === i ? 'Apagar?' : '×') : null
      );
      box.appendChild(chip);
    });
    box.appendChild(el('button', { class: 'conv-new', type: 'button', onclick: newConv }, '+ Nova conversa'));
  }

  /* ---------- Lado a lado ---------- */
  function originNote(o) {
    return o.note ? fill(o.note) : 'Mensagem pré-preenchida: “' + o.client + '”';
  }
  function column(head, note, bubbles) {
    var body = el('div', { class: 'col-body' });
    if (note) body.appendChild(el('div', { class: 'sys' }, note));
    bubbles.forEach(function (b) { body.appendChild(bubble(b)); });
    return el('div', { class: 'col' }, el('div', { class: 'col-head' }, head), body);
  }
  function section(title, lead, children) {
    var s = el('div', { class: 'sec' }, el('h2', null, title), el('p', { class: 'lead' }, lead));
    children.forEach(function (c) { s.appendChild(c); });
    return s;
  }
  function renderSbs() {
    var root = document.getElementById('sbs');
    root.textContent = '';

    root.appendChild(section('Quando o cliente responde sobre a ocasião', 'A pergunta é a mesma. A sua resposta muda conforme o perfil de quem escreveu.', [
      el('div', { class: 'cols five' }, OCC.map(function (o) { return column(o.label, null, [{ t: 'l', text: o.text }]); }))
    ]));

    root.appendChild(section('Em seguida, conforme a origem do contato', 'Logo depois da resposta sobre a ocasião, a mensagem depende de onde o cliente veio.', [
      el('div', { class: 'cols' }, ORIGIN.map(function (o) { return column(o.label, originNote(o), (o.first ? [{ t: 'l', text: G1 }, { t: 'l', text: G2 }] : []).concat([{ t: 'l', text: o.ask }])); }))
    ]));

    root.appendChild(section('Quando o cliente quer saber mais sobre o modelo', 'A primeira mensagem muda conforme o modelo. A segunda, sobre as pedras, tem duas versões, conforme o modelo tenha ou não lab grown. A terceira, que pergunta a preferência, é igual para todos.', [
      el('div', { class: 'cols five' }, ANELS.concat(NOVOS).map(function (m) { return column(modelLabel(m), null, [{ t: 'l', text: maisText(m) }]); })),
      el('div', { class: 'cols' }, [
        column('Depois, modelos com lab grown (Laub, Sechs, Oval e Marquise)', null, [{ t: 'l', text: MAIS_2 }, { t: 'l', text: MAIS_3 }]),
        column('Depois, modelos sem lab grown (Ziel e os demais)', null, [{ t: 'l', text: MAIS_2_NO }, { t: 'l', text: MAIS_3 }])
      ])
    ]));

    root.appendChild(section('Os 9 modelos dos vídeos', 'Os vídeos vão sempre nesta ordem, em HD e sem áudio. O Marquise roda anúncio, mas não está entre os 9. Esta tabela mostra o que cada modelo permite.', [
      el('div', { class: 'cols five' }, ORDEM9.map(function (id, i) {
        var m = modelById(id);
        return column((i + 1) + '. ' + m.nome, null, [{ t: 'sys', text: modelNote(m) }]);
      }))
    ]));

    root.appendChild(section('Quando o cliente já tem um modelo em mente e traz uma referência', 'Vale para quem veio da landing page ou do Google e já sabe o que imagina. O fluxo termina na pergunta sobre a pedra.', [
      el('div', { class: 'cols' }, [column('Pedir a referência', null, M([REF_1]))].concat(
        ['ref', 'refreac', 'refpedra'].reduce(function (acc, id) { return acc.concat(getNode(id, { lab: false }).opts.map(function (o) { return optColumn(o); })); }, [])
      ))
    ]));

    root.appendChild(section('Quando o cliente quer ver os modelos', 'Você avisa, envia os vídeos e só então faz a pergunta, que tem duas versões.', [
      el('div', { class: 'col common' }, el('div', { class: 'col-head' }, 'Antes da pergunta'),
        el('div', { class: 'col-body' }, bubble({ t: 'l', text: MODELOS }), bubble({ t: 'media' }))),
      el('div', { class: 'cols' }, VARIANTS.map(function (v) { return column(v.label, null, [{ t: 'l', text: v.text }]); }))
    ]));

    root.appendChild(section('Quando o cliente pergunta o valor', 'Pode acontecer no meio da escolha do modelo. Depois dessa mensagem, a conversa volta de onde parou.', [
      el('div', { class: 'cols' }, [column('No meio da escolha do modelo', null, [{ t: 'l', text: VALOR }])])
    ]));

    function optColumn(o, headPrefix) {
      var bs = [];
      if (o.client) bs.push({ t: 'c', text: o.client });
      M(o.msgs || []).forEach(function (b) { bs.push(b); });
      return column((headPrefix || '') + o.label, o.sys || null, bs);
    }
    function nodeSection(title, lead, nodeIds) {
      var cols = [];
      nodeIds.forEach(function (id) { FLOW[id].opts.forEach(function (o) { cols.push(optColumn(o)); }); });
      return section(title, lead, [el('div', { class: 'cols' }, cols)]);
    }
    function topicColumns(list) {
      var cols = [];
      list.forEach(function (t) {
        if (t.msgs.length || !t.sub) cols.push(optColumn(t));
        if (t.sub) t.sub.opts.forEach(function (o) { cols.push(optColumn(o, t.label + ': ')); });
      });
      return cols;
    }

    root.appendChild(section('3. Definição da joia', 'Entre a escolha do modelo e a cotação: o ouro, a pedra e a pergunta que leva à cotação. A pergunta tem dois caminhos, e os modelos com lab grown ganham uma terceira pedra nas opções.', [
      el('div', { class: 'cols' }, [
        column('Depois que escolhe o modelo nos vídeos', null, M([OURO, PEDRA])),
        column('Mesma mensagem da pedra, modelos com lab grown', null, M([PEDRA_LAB])),
        column('Quando pede a cotação', null, M([COTA_INTRO])),
        column('Pergunta, caminho padrão', null, M([PERG_PADRAO])),
        column('Pergunta, oferecendo analisar as duas', null, M([PERG_DUAS])),
        column('Se o cliente escolher cotar as duas', null, M([COMBINADO])),
        column('Se pedir para explicar as pedras', null, M(EXPLICA)),
        column('Lab grown: pergunta oferecendo cotar as opções', null, M([PERG_DUAS_LAB])),
        column('Lab grown: se escolher comparar as opções', null, M([COMBINADO_LAB])),
        column('Lab grown: se pedir para explicar as pedras', null, M(EXPLICA_LAB))
      ])
    ]));
    root.appendChild(nodeSection('4. Proposta', 'Depois que o cliente define o que prefere, você envia a cotação. O orçamento por escrito segue sempre o mesmo modelo.', ['proposta']));
    root.appendChild(el('div', { class: 'cols common' }, [column('Quando o esboço 3D foi feito com a pedra de outro tamanho', null, [{ t: 'l', text: ORC_NOTA }])]));
    root.appendChild(nodeSection('Quando o cliente vai analisar com calma', 'Duas versões de combinado de retorno.', ['calma']));
    root.appendChild(section('5. Perguntas e objeções, a qualquer momento', 'No passo a passo, estes temas ficam em uma caixa recolhível no rodapé da conversa. Depois de responder, a conversa volta de onde parou.', [
      el('div', { class: 'cols' }, topicColumns(TOPICS))
    ]));
    root.appendChild(nodeSection('6. Pausa e follow-ups', 'Quando o cliente some, a mensagem depende de há quanto tempo e do que você já sabe sobre o motivo. Abaixo, as respostas possíveis do cliente.', ['silencio', 'apos']));
    root.appendChild(section('7. Fechamento', 'Da decisão do cliente até a confirmação do pagamento, com as situações que podem surgir no caminho.', [
      el('div', { class: 'cols' }, [column('Cliente decide fechar', null, [{ t: 'c', text: 'Gostei, vamos fechar!' }].concat(M(FECHAR)))]
        .concat(['dados', 'assinou', 'pagou'].reduce(function (acc, id) { return acc.concat(FLOW[id].opts.map(function (o) { return optColumn(o); })); }, [])))
    ]));
    root.appendChild(section('8. Pós-venda', 'Atualizações durante a produção. Mandar antes de o cliente perguntar evita a cobrança.', [
      el('div', { class: 'cols' }, topicColumns(TOPICS2))
    ]));
  }

  /* ---------- Controles ---------- */
  function syncHead() {
    var n = S.nome.trim();
    document.getElementById('chat-name').textContent = n || PH.nome;
    document.getElementById('avatar').textContent = (n ? n.charAt(0) : '?').toUpperCase();
  }
  document.getElementById('f-nome').addEventListener('input', function (e) { S.nome = e.target.value; syncHead(); render(false); });
  document.getElementById('f-modelo').addEventListener('change', function (e) {
    S.modeloId = e.target.value;
    S.modelo = 'Anel ' + find(ANELS, S.modeloId).nome;
    render(false);
  });
  Array.prototype.forEach.call(document.querySelectorAll('input[name="cliente"], input[name="presenteado"]'), function (inp) {
    inp.addEventListener('change', function () { S[inp.name] = inp.value; render(false); });
  });
  document.getElementById('b-back').addEventListener('click', function () { history.pop(); render(true); });
  document.getElementById('b-reset').addEventListener('click', function () { history = []; render(true); });

  /* ---------- Abas ---------- */
  var tabs = [document.getElementById('tab-sim'), document.getElementById('tab-lado')];
  var views = [document.getElementById('view-sim'), document.getElementById('view-lado')];
  function selectTab(i, focus) {
    tabs.forEach(function (t, j) {
      t.setAttribute('aria-selected', j === i ? 'true' : 'false');
      t.tabIndex = j === i ? 0 : -1;
      views[j].hidden = j !== i;
    });
    document.getElementById('convs').hidden = i !== 0;
    if (focus) tabs[i].focus();
  }
  tabs.forEach(function (t, i) {
    t.addEventListener('click', function () { selectTab(i, false); });
    t.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); selectTab(i === 0 ? 1 : 0, true); }
    });
  });

  if (loadStore()) {
    // Conversas guardadas de antes: se algum passo não existe mais no roteiro, a conversa volta até o último passo válido.
    convs.forEach(function (c) {
      var s0 = S, h0 = history;
      S = c.S; history = c.history;
      for (;;) {
        try { build(); break; } catch (e) { if (!history.length) break; history = history.slice(0, -1); }
      }
      c.history = history; S = s0; history = h0;
    });
    S = convs[cur].S; history = convs[cur].history;
    syncForm();
  } else {
    convs = [{ S: S, history: history }];
    cur = 0;
  }
  syncHead();
  render(false);
  chat.scrollTop = chat.scrollHeight;
})();
</script>
</body>
</html>

      return v || PH[k] || m;
    });
  }
  function find(list, id) { return list.filter(function (x) { return x.id === id; })[0]; }

  /* ---------- Montagem da conversa ---------- */
  function build() {
    var out = [], trail = [], A = { used: {} }, pendingSub = null;
    history.forEach(function (h, i) {
      if (h.k === 'origin') {
        var o = find(ORIGIN, h.v); A.origin = o;
        if (o.note) out.push({ t: 'sys', text: o.note });
        if (o.client) out.push({ t: 'c', text: o.client, real: true });
        if (o.first) out.push({ t: 'l', text: G1 }, { t: 'l', text: G2 }, { t: 'l', text: L2 });
        else out.push({ t: 'l', text: L1 }, { t: 'l', text: L2 });
        trail.push(o.label);
      } else if (h.k === 'occ') {
        var oc = find(OCC, h.v); A.occ = oc;
        out.push({ t: 'c', text: oc.label }, { t: 'l', text: oc.text }, { t: 'l', text: A.origin.ask });
        trail.push(oc.label);
      } else if (h.k === 'seg') {
        var sg = find(A.origin.seg, h.v); A.seg = sg;
        out.push({ t: 'c', text: sg.label });
        if (sg.id === 'modelos') out.push({ t: 'l', text: MODELOS }, { t: 'media', cap: '9 vídeos, sempre nesta ordem: ' + ORDEM9.map(function (id) { return modelById(id).nome; }).join(', ') });
        else if (A.origin.id === 'anuncio') {
          A.model = S.modeloId; A.mname = S.modelo; A.lab = !!LAB[S.modeloId];
          out.push({ t: 'l', text: maisText(find(ANELS, S.modeloId)) }, { t: 'l', text: LAB[S.modeloId] ? MAIS_2 : MAIS_2_NO }, { t: 'l', text: MAIS_3 });
          A.node = 'definicao';
        } else { A.mname = '[modelo]'; out.push({ t: 'l', text: REF_1 }); A.node = 'ref'; }
        trail.push(sg.label);
      } else if (h.k === 'variant') {
        var vr = find(VARIANTS, h.v); A.variant = vr;
        out.push({ t: 'l', text: vr.text });
        trail.push('Pergunta: ' + vr.label.toLowerCase());
        A.node = 'escolha';
      } else if (h.k === 'topic') {
        var tp = find(ALL_TOPICS, h.v);
        A.used[tp.id] = true;
        if (tp.client) out.push({ t: 'c', text: tp.client });
        push(M(tp.msgs));
        trail.push(tp.label);
        pendingSub = tp.sub ? tp : null;
      } else if (h.k === 'sub') {
        var so = find(pendingSub.sub.opts, h.v);
        if (so.client) out.push({ t: 'c', text: so.client });
        push(M(so.msgs));
        trail.push(so.label);
        pendingSub = null;
      } else if (h.k === 'f') {
        var op = find(getNode(h.node, A).opts, h.v);
        if (op.model) {
          var mm = modelById(op.model);
          A.model = op.model; A.mname = modelLabel(mm); A.lab = !!LAB[op.model];
          out.push({ t: 'c', text: op.client });
          out.push({ t: 'sys', text: 'Lembrete: ' + modelNote(mm) });
        } else {
          if (op.sys) out.push({ t: 'sys', text: op.sys });
          if (op.client) out.push({ t: 'c', text: op.client });
        }
        push(M(op.msgs || []));
        if (op.sale) A.sale = true;
        if (op.lab) A.lab = true;
        A.node = op.goto || null;
        trail.push(op.label);
      }
    });

    function push(list) {
      list.forEach(function (b) {
        if (A.mname && typeof b.text === 'string') b = Object.assign({}, b, { text: b.text.replace(/\{modelo\}/g, A.mname) });
        out.push(b);
      });
    }

    var ask = null;
    if (pendingSub) ask = { key: 'sub', prompt: pendingSub.sub.prompt, opts: pendingSub.sub.opts };
    else if (!A.origin) ask = { key: 'origin', prompt: 'Como o cliente chegou?', opts: ORIGIN };
    else if (!A.occ) ask = { key: 'occ', prompt: 'O que o cliente respondeu sobre a ocasião?', opts: OCC };
    else if (!A.seg) ask = { key: 'seg', prompt: 'O que o cliente respondeu?', opts: A.origin.seg };
    else if (A.seg.id === 'modelos' && !A.variant) ask = { key: 'variant', prompt: 'Depois de enviar os vídeos, qual pergunta você faz?', opts: VARIANTS };
    else if (A.node) { var nd = getNode(A.node, A); ask = { key: 'f', node: A.node, prompt: nd.prompt, opts: nd.opts }; }

    return { out: out, trail: trail.map(function (t) { return fill(t); }), ask: ask, hasOrigin: !!A.origin, used: A.used, sale: !!A.sale };
  }

  /* ---------- DOM ---------- */
  function el(tag, props) {
    var n = document.createElement(tag), k, i, c;
    props = props || {};
    for (k in props) {
      var v = props[k];
      if (k === 'class') n.className = v;
      else if (k.indexOf('on') === 0) n.addEventListener(k.slice(2), v);
      else if (v === true) n.setAttribute(k, '');
      else if (v !== false && v != null) n.setAttribute(k, v);
    }
    function add(c) {
      if (c == null || c === false) return;
      if (Array.isArray(c)) { c.forEach(add); return; }
      n.appendChild(typeof c === 'object' ? c : document.createTextNode(c));
    }
    for (i = 2; i < arguments.length; i++) add(arguments[i]);
    return n;
  }

  function copyButton(getText, textNode) {
    var b = el('button', { class: 'cp', type: 'button', 'aria-label': 'Copiar mensagem' }, 'Copiar');
    var timer;
    function done(msg) {
      b.textContent = msg;
      clearTimeout(timer);
      timer = setTimeout(function () { b.textContent = 'Copiar'; }, 1600);
    }
    function fallback() {
      try {
        var r = document.createRange();
        r.selectNodeContents(textNode);
        var s = window.getSelection();
        s.removeAllRanges();
        s.addRange(r);
      } catch (e) { /* sem seleção disponível */ }
      done('Selecionado, copie com Ctrl+C');
    }
    b.addEventListener('click', function () {
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(getText()).then(function () { done('Copiado'); }, fallback);
        } else { fallback(); }
      } catch (e) { fallback(); }
    });
    return b;
  }

